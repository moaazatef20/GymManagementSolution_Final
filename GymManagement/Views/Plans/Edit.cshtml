@model UpdatePlanViewModel

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 overflow-hidden">

                <div class="card-header text-white text-center py-5 bg-primary-color">
                    <i class="bi bi-award display-4 mb-3"></i>
                    <h2 class="mb-0 text-white">@Model.Name</h2>
                    <span class="badge bg-light text-primary-color mt-2">Edit Mode</span>
                </div>

                <div class="card-body p-5">

                    <div asp-validation-summary="All" class="text-danger mb-4 fw-bold"></div>

                    <form asp-action="Edit" method="post">
                        <input hidden asp-for="Name" />

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="DurationDays" class="form-label fw-semibold">
                                    Duration (Days) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-calendar-check text-primary-color"></i></span>
                                    <input asp-for="DurationDays" type="number" class="form-control border-start-0" />
                                </div>
                                <span asp-validation-for="DurationDays" class="text-danger d-block mt-1"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label fw-semibold">
                                    Price (EGP) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-cash text-primary-color"></i></span>
                                    <input asp-for="Price" type="number" step="0.01" class="form-control border-start-0" />
                                </div>
                                <span asp-validation-for="Price" class="text-danger d-block mt-1"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold">
                                    Description <span class="text-danger">*</span>
                                </label>
                                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Update the plan details and benefits..."></textarea>
                                <span asp-validation-for="Description" class="text-danger d-block mt-1"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-5 pt-4 border-top">
                            <a asp-action="Index" class="btn btn-outline px-4">
                                <i class="bi bi-arrow-left me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-fill px-4">
                                <i class="bi bi-check-lg me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}