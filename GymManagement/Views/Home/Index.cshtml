@using GymManagement.BLL.ViewModels.DashBoardViewModels
@model DashBoardViewModel
@{
    ViewData["Title"] = "Home";
    ViewData["FullWidth"] = true;
}

<div class="home-page">

    <!-- Hero -->
    <section class="home-hero">
        <div class="container">
            <div class="row align-items-center g-4">
                <div class="col-12 col-lg-7 home-hero__content">
                    <header class="text-black-alternative home-section">
                        <h2 class="fw-bolder display-2 mb-4">
                            Your body can
                            <span class="text-primary-color">stand almost</span> anything
                        </h2>
                        <p class="mb-5 hero-text">
                            It's your mind that needs convincing. Push past your limits,
                            stay committed, and watch as your body transform into powerhouse of
                            strength and resilience. Start your journey today &amp; truly capable of!
                        </p>
                    </header>

                    <div class="stats-bar mb-5">
                        <div class="row g-4">
                            <div class="col-4">
                                <div class="stat">
                                    <span class="fw-bolder d-block mb-1">@Model.TotalMembers</span>
                                    <h3 class="fw-normal mb-0">Total Members</h3>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stat">
                                    <span class="fw-bolder d-block mb-1">@Model.ActiveMembers</span>
                                    <h3 class="fw-normal mb-0">Active Members</h3>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stat">
                                    <span class="fw-bolder d-block mb-1">@Model.TotalTrainers</span>
                                    <h3 class="fw-normal mb-0">Trainers</h3>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stat">
                                    <span class="fw-bolder d-block mb-1">@Model.UpcomingSessions</span>
                                    <h3 class="fw-normal mb-0">Upcoming Sessions</h3>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stat">
                                    <span class="fw-bolder d-block mb-1">@Model.OngoingSessions</span>
                                    <h3 class="fw-normal mb-0">Ongoing Sessions</h3>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stat">
                                    <span class="fw-bolder d-block mb-1">@Model.CompletedSessions</span>
                                    <h3 class="fw-normal mb-0">Completed Sessions</h3>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="home-hero__buttons">
                        <a asp-controller="Plans" asp-action="Index" class="get-started btn rounded-5 fw-medium px-4 py-2 me-4">
                            Get Started
                        </a>
                        <a asp-controller="Sessions" asp-action="Index" class="explore-more btn rounded-5 fw-medium px-4 py-2">
                            Explore More
                        </a>
                    </div>
                </div>

                <div class="col-12 col-lg-5">
                    <div class="home-hero__character">
                        <img src="@Url.Content("~/images/Theo Vance.jpg")" alt="Theo Vance" class="home-hero__img" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Ticker -->
    <div class="marquee-bar bg-primary-color text-white fw-bolder">
        <div class="marquee-track">
            <span>
                outdoor &amp; online trainers
                <img src="~/images/star.svg" alt="" class="marquee-star" /> personal training
                <img src="~/images/star.svg" alt="" class="marquee-star" /> live classes
                <img src="~/images/star.svg" alt="" class="marquee-star" /> personal trainers
                <img src="~/images/star.svg" alt="" class="marquee-star" /> group workouts
            </span>
            <span aria-hidden="true">
                outdoor &amp; online trainers
                <img src="~/images/star.svg" alt="" class="marquee-star" /> personal training
                <img src="~/images/star.svg" alt="" class="marquee-star" /> live classes
                <img src="~/images/star.svg" alt="" class="marquee-star" /> personal trainers
                <img src="~/images/star.svg" alt="" class="marquee-star" /> group workouts
            </span>
        </div>
    </div>

    <!-- About -->
    <section class="about py-5">
        <div class="container">
            <div class="row align-items-center g-4 g-lg-5">
                <div class="col-12 col-lg-6">
                    <div class="characters position-relative">
                        <div class="image image--main">
                            <img src="@Url.Content("~/images/about p1.jpg")" alt="Gym member" class="img-about-1" />
                        </div>
                        <div class="image image--secondary position-absolute d-none d-lg-block">
                            <img src="@Url.Content("~/images/about p2.jpg")" alt="Gym member" class="img-about-2" />
                        </div>
                        <div class="image image--tertiary position-absolute d-none d-lg-block">
                            <img src="@Url.Content("~/images/about p3.jpg")" alt="Gym member" class="img-about-3" />
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="section-label d-flex align-items-center gap-2 mb-3">
                        <img src="@Url.Content("~/images/dumbbell.jpg")" alt="" class="img-icon" />
                        <h2 class="text-primary-color fs-5 mb-0">About Us</h2>
                    </div>

                    <header class="mb-4">
                        <p class="fw-bolder display-6 mb-3">
                            EMPOWERING YOU TO ACHIEVE
                            <span class="text-primary-color">YOUR FITNESS</span> GOALS
                        </p>
                        <p class="text mb-0">
                            We believe fitness is more than just a workout—it's a lifestyle. With top-of-the-line
                            facilities, certified trainers, and a supportive community, we're here to inspire
                            and guide you every step of the way.
                        </p>
                    </header>

                    <div class="features">
                        <div class="row row-cols-1 row-cols-sm-2 g-4">
                            <div class="col">
                                <div class="feature-card">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <img src="@Url.Content("~/images/feature icon.jpg")" alt="" class="img-icon" />
                                        <h3 class="fw-bold fs-6 mb-0">Personal Trainer</h3>
                                    </div>
                                    <p class="mb-0 small">Achieve your fitness goals with the guidance of our certified trainers.</p>
                                </div>
                            </div>
                            <div class="col">
                                <div class="feature-card">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <img src="@Url.Content("~/images/feature icon.jpg")" alt="" class="img-icon" />
                                        <h3 class="fw-bold fs-6 mb-0">Group Classes</h3>
                                    </div>
                                    <p class="mb-0 small">Train together, stay motivated, and push your limits in every session.</p>
                                </div>
                            </div>
                            <div class="col">
                                <div class="feature-card">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <img src="@Url.Content("~/images/feature icon.jpg")" alt="" class="img-icon" />
                                        <h3 class="fw-bold fs-6 mb-0">Modern Equipment</h3>
                                    </div>
                                    <p class="mb-0 small">Access premium machines and tools designed for every fitness level.</p>
                                </div>
                            </div>
                            <div class="col">
                                <div class="feature-card">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <img src="@Url.Content("~/images/feature icon.jpg")" alt="" class="img-icon" />
                                        <h3 class="fw-bold fs-6 mb-0">Flexible Plans</h3>
                                    </div>
                                    <p class="mb-0 small">Choose membership plans that fit your schedule and personal goals.</p>
                                </div>
                            </div>
                        </div>
                        <a asp-controller="Plans" asp-action="Index" class="btn bg-primary-color rounded-pill text-white fw-medium px-4 py-2 mt-4">
                            Get Started
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Workouts Slider -->
    <section class="workout py-5">
        <div class="container">
            <div class="workout-title text-center mb-4 mb-lg-5">
                <h2>WORKOUTS</h2>
                <p class="text-white fw-bolder fs-4 mb-0">
                    Transform Your Body with Our Dynamic Upcoming Workouts
                </p>
            </div>

            <div class="workout-slider" id="workoutSlider">
                <div class="workout-slider__viewport">
                    <div class="workout-slider__track">
                        <div class="workout-slider__slide">
                            <div class="workout-card card h-100">
                                <div class="workout-card__image">
                                    <img src="@Url.Content("~/images/workout 1.jpg")" alt="Group workout" class="img-workout-1" loading="lazy" />
                                </div>
                                <div class="card-footer bg-white border-0 pt-3 pb-4 px-4">
                                    <h5 class="card-title text-black-alternative text-uppercase fw-bolder mb-2">Group Workout</h5>
                                    <a asp-controller="Sessions" asp-action="Index" class="workout-link">Explore</a>
                                </div>
                            </div>
                        </div>
                        <div class="workout-slider__slide">
                            <div class="workout-card card h-100">
                                <div class="workout-card__image">
                                    <img src="@Url.Content("~/images/workout 2.jpg")" alt="Strength training" class="img-workout-2" loading="lazy" />
                                </div>
                                <div class="card-footer bg-white border-0 pt-3 pb-4 px-4">
                                    <h5 class="card-title text-black-alternative text-uppercase fw-bolder mb-2">Strength Training</h5>
                                    <a asp-controller="Sessions" asp-action="Index" class="workout-link">Explore</a>
                                </div>
                            </div>
                        </div>
                        <div class="workout-slider__slide">
                            <div class="workout-card card h-100">
                                <div class="workout-card__image">
                                    <img src="@Url.Content("~/images/workout 3.jpg")" alt="Cardio session" class="img-workout-3" loading="lazy" />
                                </div>
                                <div class="card-footer bg-white border-0 pt-3 pb-4 px-4">
                                    <h5 class="card-title text-black-alternative text-uppercase fw-bolder mb-2">Cardio Session</h5>
                                    <a asp-controller="Sessions" asp-action="Index" class="workout-link">Explore</a>
                                </div>
                            </div>
                        </div>
                        <div class="workout-slider__slide">
                            <div class="workout-card card h-100">
                                <div class="workout-card__image">
                                    <img src="@Url.Content("~/images/workout 1.jpg")" alt="HIIT training" class="img-workout-1" loading="lazy" />
                                </div>
                                <div class="card-footer bg-white border-0 pt-3 pb-4 px-4">
                                    <h5 class="card-title text-black-alternative text-uppercase fw-bolder mb-2">HIIT Training</h5>
                                    <a asp-controller="Sessions" asp-action="Index" class="workout-link">Explore</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="workout-slider__controls d-flex justify-content-center align-items-center gap-2 mt-4">
                    <button type="button" class="workout-slider__arrow" data-direction="prev" aria-label="Previous slide">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <div class="indicators d-flex gap-2" role="tablist"></div>
                    <button type="button" class="workout-slider__arrow" data-direction="next" aria-label="Next slide">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- Why Us -->
    <section class="why-us py-5">
        <div class="container">
            <div class="row align-items-center g-4 g-lg-5">
                <div class="col-12 col-lg-6">
                    <div class="section-label d-flex align-items-center gap-2 mb-3">
                        <img src="@Url.Content("~/images/dumbbell.jpg")" alt="" class="img-icon" />
                        <h2 class="text-primary-color fs-5 mb-0">Why Us</h2>
                    </div>

                    <header class="mb-4">
                        <p class="fw-bolder display-5 mb-3">
                            Elevate fitness with
                            <span class="text-primary-color">the best</span> way possible
                        </p>
                        <p class="text mb-0">
                            We believe fitness is more than just a workout—it's a lifestyle. With top-of-the-line
                            facilities, certified trainers, and a supportive community, we're here to inspire
                            and guide you every step of the way.
                        </p>
                    </header>

                    <ul class="why-us-list list-unstyled mb-0">
                        <li class="why-us-item d-flex gap-3 align-items-start mb-4">
                            <div class="count">01</div>
                            <div>
                                <h3 class="text-capitalize fw-bold fs-5 mb-2">Personalized Fitness Plans</h3>
                                <p class="fs-18 mb-0">We tailor every workout to fit your unique goals and fitness level.</p>
                            </div>
                        </li>
                        <li class="why-us-item d-flex gap-3 align-items-start mb-4">
                            <div class="count">02</div>
                            <div>
                                <h3 class="text-capitalize fw-bold fs-5 mb-2">Expert Coaching Team</h3>
                                <p class="fs-18 mb-0">Train with certified professionals who keep you motivated and on track.</p>
                            </div>
                        </li>
                        <li class="why-us-item d-flex gap-3 align-items-start">
                            <div class="count">03</div>
                            <div>
                                <h3 class="text-capitalize fw-bold fs-5 mb-2">Results-Driven Programs</h3>
                                <p class="fs-18 mb-0">Structured sessions designed to help you build strength and endurance.</p>
                            </div>
                        </li>
                    </ul>
                </div>

                <div class="col-12 col-lg-6 d-none d-lg-block">
                    <div class="why-us-image">
                        <img src="@Url.Content("~/images/about p2.jpg")" alt="Fitness training" class="img-why-us" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="home-footer">
        <div class="marquee-bar bg-primary-color text-white fw-bolder">
            <div class="marquee-track">
                <span>
                    outdoor &amp; online trainers
                    <img src="~/images/star.svg" alt="" class="marquee-star" /> personal training
                    <img src="~/images/star.svg" alt="" class="marquee-star" /> live classes
                    <img src="~/images/star.svg" alt="" class="marquee-star" /> personal trainers
                    <img src="~/images/star.svg" alt="" class="marquee-star" /> group workouts
                </span>
                <span aria-hidden="true">
                    outdoor &amp; online trainers
                    <img src="~/images/star.svg" alt="" class="marquee-star" /> personal training
                    <img src="~/images/star.svg" alt="" class="marquee-star" /> live classes
                    <img src="~/images/star.svg" alt="" class="marquee-star" /> personal trainers
                    <img src="~/images/star.svg" alt="" class="marquee-star" /> group workouts
                </span>
            </div>
        </div>

        <div class="footer-content py-5">
            <div class="container">
                <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4 g-lg-5">
                    <div class="col">
                        <div class="footer-logo mb-3">
                            <img src="@Url.Content("~/images/logo.jpg")" alt="Power Fitness logo" class="img-logo" />
                        </div>
                        <p class="fs-18 mb-0">
                            Push harder, go further. Your fitness journey starts today!
                        </p>
                    </div>

                    <div class="col">
                        <h4 class="fw-bolder text-uppercase mb-3">Contact Us</h4>
                        <ul class="footer-contact list-unstyled mb-0">
                            <li class="d-flex align-items-center gap-2 mb-3">
                                <img src="@Url.Content("~/images/phone icon.jpg")" alt="" class="img-icon-sm" />
                                <span>+91 123 456 789</span>
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <img src="@Url.Content("~/images/message icon.jpg")" alt="" class="img-icon-sm" />
                                <span>info@gmail.com</span>
                            </li>
                        </ul>
                    </div>

                    <div class="col">
                        <h4 class="fw-bolder text-uppercase mb-3">Our Gym Timing</h4>
                        <p class="mb-0">
                            Mon - Fri : 08:00 AM - 10:00 PM<br />
                            Sat - Sun : 08:00 AM - 09:00 PM
                        </p>
                    </div>

                    <div class="col">
                        <h4 class="fw-bolder text-uppercase mb-3">Our Location</h4>
                        <p class="mb-0">
                            2715 Ash Dr. San Jose, South<br />
                            Dakota 83475
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </footer>

</div>